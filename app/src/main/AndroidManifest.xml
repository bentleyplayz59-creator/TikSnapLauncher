<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.bytesnap.tiksnap" />
        <package android:name="com.sec.android.app.samsungapps" />
        <package android:name="com.sec.android.gallery3d" />
        <package android:name="com.android.vending" />
        <package android:name="com.google.android.googlequicksearchbox" />
        <package android:name="com.samsung.android.dialer" />
        <package android:name="com.android.dialer" />
        <package android:name="com.google.android.dialer" />
        <package android:name="com.samsung.android.messaging" />
        <package android:name="com.google.android.apps.messaging" />
        <package android:name="com.android.chrome" />
        <package android:name="com.sec.android.app.camera" />
        <package android:name="com.android.camera2" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="TikSnapLauncher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
